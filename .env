# Copie para .env e ajuste os valores reais antes de iniciar.
# Nenhum valor real deve ser commitado.

ASPNETCORE_ENVIRONMENT=Production
Web__Url=http://127.0.0.1:8080
Api__Url=http://127.0.0.1:5081
ConnectionStrings__Copilot=Host=127.0.0.1;Port=5432;Database=company_copilot;Username=copilot;Password=change-me
Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__ChatModel=empresa-copiloto:v1
Ollama__EmbeddingModel=embeddinggemma
Ollama__ContextLength=8192
Chat__MaxQuestionCharacters=2000
Chat__MaxHistoryTurns=6
Chat__SessionIdleMinutes=20
Chat__MaxOutputTokens=512
Storage__Root=./data

# Somente quando o acesso externo for via proxy Cloudflare (nÃ£o para o Quick Tunnel):
# Security__TrustCloudflareProxy=true
