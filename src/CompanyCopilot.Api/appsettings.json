{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5081",
  "Web": {
    "Url": "http://127.0.0.1:8080"
  },
  "ConnectionStrings": {
    "Copilot": "Host=127.0.0.1;Port=5432;Database=company_copilot;Username=copilot;Password=change-me"
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "ChatModel": "empresa-copiloto:v1",
    "EmbeddingModel": "embeddinggemma",
    "ContextLength": 8192,
    "EmbeddingDimensions": 768,
    "Timeout": "00:03:00"
  },
  "Chat": {
    "MaxQuestionCharacters": 2000,
    "MaxHistoryTurns": 6,
    "SessionIdleMinutes": 20,
    "MaxOutputTokens": 512,
    "MaxRetrievedChunks": 6,
    "MaxQuestionsPerWindow": 8,
    "RateLimitWindowMinutes": 10,
    "MaxConcurrentGenerations": 1,
    "MaxQueuedGenerations": 5
  },
  "Storage": {
    "Root": "./data",
    "MaxUploadBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".txt", ".md", ".html", ".htm" ]
  },
  "VectorSearch": {
    "VectorSearchTake": 10,
    "TextSearchTake": 10,
    "RrfK": 60,
    "ConflictSimilarityMin": 0.55,
    "ConflictSimilarityMax": 0.97
  },
  "Security": {
    "TrustCloudflareProxy": false,
    "TrustedClientIpProxies": [ "127.0.0.1", "::1" ]
  }
}
