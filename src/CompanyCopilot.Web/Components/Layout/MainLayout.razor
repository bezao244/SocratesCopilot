@inherits LayoutComponentBase

<div class="layout-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/" aria-label="SocratesCopilot - página inicial">
                <img class="brand-logo" src="@Assets["images/logo.png"]" alt="SocratesCopilot" />
            </a>
            <div class="topbar-actions">
                <nav class="topnav">
                    <a href="/" class="nav-link">Chat</a>
                    <a href="/admin" class="nav-link nav-link-admin" title="Apenas em loopback">Admin local</a>
                </nav>
                <label class="appearance-picker" for="theme-select">
                    Aparência
                    <select id="theme-select"
                            class="theme-select"
                            data-theme-select
                            aria-label="Selecionar aparência"
                            onchange="window.themePreference && window.themePreference.setTheme(this.value)">
                        <option value="light">☀️ Modo claro</option>
                        <option value="dark">🌙 Modo escuro</option>
                    </select>
                </label>
            </div>
        </div>
    </header>

    <main class="layout-body">
        @Body
    </main>

    <footer class="footer">
        <span>Respostas baseadas exclusivamente em conteúdo público aprovado.</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">✕</span>
</div>
